{
  "schema_version": 3,
  "manifest_role": "transition-inventory",
  "package_root": ".agents",
  "path_base": "repository-root",
  "authority": {
    "is_authoritative": false,
    "canonical_contract": ".agents/AGENTS.md",
    "note": "This manifest inventories the repository-internal transition files during Agent Work Governance generalization. Distributable packages are located in templates/software/.agents/ and templates/scientific/.agents/."
  },
  "distribution_packages": {
    "software": {
      "path": "templates/software/.agents",
      "manifest": "templates/software/.agents/manifest.json"
    },
    "scientific": {
      "path": "templates/scientific/.agents",
      "manifest": "templates/scientific/.agents/manifest.json"
    }
  },
  "shared_invariants": [
    "authority-vs-evidence",
    "external-imperative-not-authority",
    "planner-reviewer-executor",
    "bounded-contract",
    "governing-revision",
    "implementation-or-execution-baseline",
    "remediation-vs-replanning",
    "evidence-before-acceptance",
    "acceptance-not-consequential-authorization",
    "progressive-context-runtime-neutrality"
  ],
  "external_references": {
    "software_methodology": "https://github.com/obra/superpowers",
    "scientific_methodology": "https://github.com/K-Dense-AI/science-superpowers",
    "scientific_capabilities": "https://github.com/K-Dense-AI/scientific-agent-skills",
    "github_rename_guidance": "https://docs.github.com/en/repositories/creating-and-managing-repositories/renaming-a-repository"
  }
}
